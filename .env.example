# --- LLM provider: heuristic (offline, no key) | anthropic | openai ---
LLM_PROVIDER=heuristic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Database: SQLite by default; Postgres/Supabase via SQLAlchemy URL ---
DATABASE_URL=sqlite:///./intake.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# --- Mock carrier portal ---
# Base URL the automation uses to reach the portal (this same app, by default)
PORTAL_BASE_URL=http://127.0.0.1:8000
# auto | http | playwright
PORTAL_DRIVER=auto
PORTAL_MAX_ATTEMPTS=3
# 0.0 - 1.0: fraction of portal requests that fail on purpose (to exercise retries)
PORTAL_FAILURE_RATE=0.0

# --- API protection: if set, /inbound and /cases* require header X-API-Key ---
# API_KEY=change-me
